Clinical:
    PatientAssessment (
        SimpleComparison: {x > 10}
        EqualityCheck: {value == 5}
        LogicalAnd: {(age > 18) && (income < 50000)}
        LogicalOr: {isStudent || isRetired}
        TernaryBasic: {score >= 90 ? "A" : "B"}
        NestedConditional: {
            age < 18 ? "Minor" : 
            (age >= 18 && age < 65) ? "Adult" : 
            "Senior"
        }
        ComplexCondition: {
            (temperature > 38.5) && (symptoms == "fever") ? "High Risk" : "Normal"
        }
        NegationExample: {!(x < 0)}
        MixedArithmeticAndCondition: {
            (total > 100) ? total * 1.1 : total
        }
)

Orders:
    MedicalDecisions (
        DosageAdjustment: {
            weight > 70 ? "High Dose" : "Standard Dose"
        }
        EmergencyTriage: {
            (heartRate > 100 || bloodPressure > 140) ? "Immediate" : "Monitor"
        }
)